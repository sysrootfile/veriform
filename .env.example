# Panel sunucusu
PORT=4620

# Veritabanı (boşsa in-memory; compose bunu otomatik ayarlar)
DATABASE_URL=postgresql://postgres:veriform@127.0.0.1:54329/veriform

# Zorunlu anahtarlar — hiçbirinin default'u yok; eksikse panel boot etmez,
# compose `${VAR:?}` ile durur. `cp .env.example .env` sonra bu ikisini doldur.

# Postgres parolası (compose hem db konteyneri hem DATABASE_URL için kullanır)
POSTGRES_PASSWORD=

# Panel oturum imza anahtarı — openssl rand -hex 32
SESSION_SECRET=

# Oturum çerezine Secure bayrağı ekler (çerez yalnız HTTPS'te gönderilir).
# TLS sonlandıran proxy arkasında 1 yap; lokal düz HTTP'de 0/boş bırak.
# SESSION_COOKIE_SECURE=1

# Proxy/tünel arkasında limiter anahtarı: 1 iken ziyaretçi IP'si X-Forwarded-For'dan
# okunur (yalnızca soket adresi özel ağ/loopback ise güvenilir). Doğrudan internete
# açık panelde 0/boş bırak — soket adresi zaten gerçek ziyaretçidir.
# TRUST_PROXY=1

# Rotasyon: 1) PREVIOUS'e mevcut SESSION_SECRET'ı yaz  2) SESSION_SECRET'ı yenisiyle değiştir
# 3) docker compose up -d  4) bir tam oturum süresi (7 gün) bekleyip PREVIOUS satırını sil.
# PREVIOUS dolu iken eski ve yeni anahtarla açılmış oturumlar birlikte çalışır; silinince eski çerezler düşer.
# SESSION_SECRET_PREVIOUS=

# /internal/run-scheduled tetikleyici anahtarı; SESSION_SECRET'ten farklı olmalı.
# Boş bırakılırsa uç kapalı kalır (her çağrı 403) — döngüsel scheduler bunu gerektirmez.
# WORKER_TOKEN=

# E-posta bildirimleri (SMTP) — https panelde zorunlu; yerel http kurulumda boşsa
# mail yerine console'a log düşer
# SMTP_HOST=smtp.ajans.com
# SMTP_PORT=587
# SMTP_USER=panel@ajans.com
# SMTP_PASS=...
# SMTP_FROM=Veriform <panel@ajans.com>

# Landing iletişim formu taleplerinin gideceği operatör adresi
# CONTACT_OPERATOR_EMAIL=iletisim@ajans.com

# Panelin dıştan erişilen kök adresi — Postgres modunda ZORUNLU: mail bağlantıları ve
# embed adresi istek Host başlığından türetilmez. Yerel compose: http://localhost:4620
# PANEL_URL=https://panel.ajans.com
