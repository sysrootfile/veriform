{
  "name": "veriform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Veriform — form veri akış izleyici ve uyum katmanı",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build": "pnpm build:embed && pnpm build:panel && pnpm build:scan",
    "build:embed": "esbuild src/embed/main.ts --bundle --format=iife --target=es2020 --outfile=dist/veriform-embed.js --log-level=info",
    "build:scan": "esbuild src/scanner/cli.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/scan.mjs --log-level=silent",
    "scan": "pnpm build:scan && node dist/scan.mjs",
    "build:demo": "esbuild src/report/demo.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/demo.mjs --log-level=silent",
    "demo": "pnpm build:demo && node dist/demo.mjs",
    "build:panel": "esbuild src/panel/server.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/panel.mjs --log-level=silent",
    "panel": "pnpm build:panel && node dist/panel.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "esbuild": "^0.28.2",
    "happy-dom": "^21.0.4",
    "playwright": "^1.64.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "esbuild": "^0.28.2",
    "nodemailer": "^10.3.1",
    "pg": "^8.23.1"
  }
}
